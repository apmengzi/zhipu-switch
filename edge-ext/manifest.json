{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.3.2",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
